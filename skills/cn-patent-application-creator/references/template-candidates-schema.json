{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cn-patent-template-candidates/v1",
  "title": "中国专利范本候选清单",
  "description": "范本候选的检索证据与技术相关性评分。IPC 可暂缺，由排序脚本优先通过 EPO OPS 补全。",
  "type": "object",
  "required": ["schema_id", "candidates"],
  "properties": {
    "schema_id": {"const": "cn-patent-template-candidates/v1"},
    "searched_at": {"type": "string", "minLength": 1},
    "database": {"type": "string", "minLength": 1},
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["publication_number", "title", "technical_relevance_score", "technical_relevance_reason"],
        "properties": {
          "publication_number": {"type": "string", "minLength": 3},
          "title": {"type": "string", "minLength": 1},
          "assignee": {"type": "string"},
          "search_rank": {"type": "integer", "minimum": 0},
          "search_query": {"type": "string"},
          "technical_relevance_score": {"type": "number", "minimum": 0, "maximum": 1},
          "technical_relevance_reason": {"type": "string", "minLength": 1},
          "ipc_codes": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "classification_source": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
